{
  "name": "twin-morph-server",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS co-op game server for Twin Morph (Socket.IO gateway, room/game state, authoritative tick loop).",
  "scripts": {
    "dev": "ts-node --transpile-only src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server/src/main.js"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/platform-socket.io": "^12.0.1",
    "@nestjs/websockets": "^12.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}

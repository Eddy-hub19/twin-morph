# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/server/node_modules
/server/dist
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — *.local — секретные/локальные оверрайды, никогда не коммитим.
# .env.production — только публичный NEXT_PUBLIC_GAME_SERVER_URL (не секрет),
# коммитится намеренно, см. .env.production в репозитории.
.env*.local
server/.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

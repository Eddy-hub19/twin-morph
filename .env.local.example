# Адрес NestJS co-op сервера (server/). Нужен клиенту только для Co-op —
# Single Player по сети вообще не ходит.
#
# Локально (см. npm run dev:server) — localhost:3001. В проде этот же файл
# существует как .env.production (коммитится, см. .gitignore) с адресом
# https://twin-morph.onrender.com — Vercel подхватывает его сам при билде,
# отдельно на него ничего настраивать не нужно.
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001
